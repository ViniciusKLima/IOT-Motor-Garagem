{
  "rules": {
    "permitidos": {
      ".write": false,
      "$email": {
        ".read": "auth != null && auth.token.email != null && auth.token.email.toLowerCase().replace('.', ',') === $email"
      }
    },

    "config": {
      ".read": "auth != null && ((auth.token.email_verified === true && root.child('permitidos').child(auth.token.email.toLowerCase().replace('.', ',')).exists()) || auth.uid === 'UID_ESP32')",
      ".write": false
    },

    "comandos": {
      ".read": "auth != null && auth.uid === 'UID_ESP32'",
      ".indexOn": ["ts"],
      "$id": {
        ".write": "auth != null && ((!data.exists() && auth.token.email_verified === true && root.child('permitidos').child(auth.token.email.toLowerCase().replace('.', ',')).exists()) || (auth.uid === 'UID_ESP32' && !newData.exists()))",
        ".validate": "newData.hasChildren(['uid', 'nome', 'acao', 'ts'])",
        "uid":  { ".validate": "newData.val() === auth.uid" },
        "nome": { ".validate": "newData.val() === root.child('permitidos').child(auth.token.email.toLowerCase().replace('.', ',')).child('nome').val()" },
        "acao": { ".validate": "newData.val() === 'acionar'" },
        "ts":   { ".validate": "newData.isNumber() && newData.val() > now - 10000 && newData.val() < now + 5000" },
        "$outro": { ".validate": false }
      }
    },

    "estado": {
      ".read": "auth != null && ((auth.token.email_verified === true && root.child('permitidos').child(auth.token.email.toLowerCase().replace('.', ',')).exists()) || auth.uid === 'UID_ESP32')",
      ".write": "auth != null && auth.uid === 'UID_ESP32'"
    },

    "historico": {
      ".read": "auth != null && auth.token.email_verified === true && root.child('permitidos').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
      ".indexOn": ["ts"],
      "$id": { ".write": "auth != null && auth.uid === 'UID_ESP32'" }
    }
  }
}
