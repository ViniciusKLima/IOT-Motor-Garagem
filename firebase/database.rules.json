{
  "rules": {
    "perfis": { ".read": true, ".write": false },
    "config": { ".read": "auth != null && (root.child('perfis').child(auth.uid).exists() || auth.uid === 'UID_ESP32')", ".write": false },

    "comandos": {
      ".read": "auth != null && auth.uid === 'UID_ESP32'",
      ".indexOn": ["ts"],
      "$id": {
        ".write": "auth != null && ((!data.exists() && root.child('perfis').child(auth.uid).exists()) || (auth.uid === 'UID_ESP32' && !newData.exists()))",
        ".validate": "newData.hasChildren(['uid', 'nome', 'acao', 'ts'])",
        "uid":  { ".validate": "newData.val() === auth.uid" },
        "nome": { ".validate": "newData.val() === root.child('perfis').child(auth.uid).child('nome').val()" },
        "acao": { ".validate": "newData.val() === 'acionar'" },
        "ts":   { ".validate": "newData.isNumber() && newData.val() > now - 10000 && newData.val() < now + 5000" },
        "$outro": { ".validate": false }
      }
    },

    "estado": {
      ".read": "auth != null && (root.child('perfis').child(auth.uid).exists() || auth.uid === 'UID_ESP32')",
      ".write": "auth != null && auth.uid === 'UID_ESP32'"
    },

    "historico": {
      ".read": "auth != null && root.child('perfis').child(auth.uid).exists()",
      ".indexOn": ["ts"],
      "$id": { ".write": "auth != null && auth.uid === 'UID_ESP32'" }
    }
  }
}
